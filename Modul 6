import numpy as np

def f(x, y):
    return y - x**2 + 1

def euler(x0, y0, h, x_target):
    x = x0
    y = y0
    while x < x_target:
        y = y + h * f(x, y)
        x = x + h
    return y

def rk4(x0, y0, h, x_target):
    x = x0
    y = y0
    while x < x_target:
        k1 = f(x, y)
        k2 = f(x + h/2, y + h*k1/2)
        k3 = f(x + h/2, y + h*k2/2)
        k4 = f(x + h, y + h*k3)
        y = y + (h/6) * (k1 + 2*k2 + 2*k3 + k4)
        x = x + h
    return y

def y_analitik(x):
    return x**2 + 2*x + 1 - 0.5*np.exp(x)

x0 = 0
y0 = 0.5
h = 0.1
x_target = 0.2

y_euler = euler(x0, y0, h, x_target)
y_rk4 = rk4(x0, y0, h, x_target)
y_exact = y_analitik(x_target)

print("Hasil metode Euler       :", y_euler)
print("Hasil metode RK4         :", y_rk4)
print("Hasil Analitik           :", y_exact)
print("Error Euler              :", abs(y_exact - y_euler))
print("Error RK4                :", abs(y_exact - y_rk4))
